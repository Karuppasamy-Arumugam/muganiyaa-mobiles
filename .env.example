# Muganiyaa-Mobiles Environment Variables Template
# Store catalogue and settings are managed through the configured Supabase backend.
# Keep private service keys in server-side environment settings, never in VITE_ variables.
# This file serves as reference configuration when connecting to a live backend.

# Future Backend API Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Store Contact Fallbacks (Overridden by Admin Settings in localStorage)
VITE_STORE_PHONE="+91 98765 43210"
VITE_STORE_WHATSAPP="919876543210"
VITE_STORE_EMAIL="info@muganiyaamobiles.com"

# Future AI Service (Groq / Gemini) — Backend Proxy recommended in production
# VITE_GROQ_API_KEY=your_groq_api_key_here
# VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Future Cloud Media Storage (Cloudinary / AWS S3)
# VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
# VITE_CLOUDINARY_UPLOAD_PRESET=your_preset
